<div class="hero-section">
  <!-- Spline 3D Background -->
  <canvas id="spline-bg" class="absolute inset-0"></canvas>
  
  <!-- Overlay Content -->
  <div class="relative z-10 text-center">
    <h1 class="text-4xl font-bold text-white">
      Transform Your Vision
    </h1>
  </div>
</div>

<!-- High-Res Image Background -->
<section 
  class="bg-cover bg-center h-screen"
  style="background-image: url('https://source.unsplash.com/1920x1080/technology')"
>
  <div class="bg-black bg-opacity-40 h-full flex items-center">
    <div class="container mx-auto text-white">
      <h2 class="text-3xl font-semibold">Premium Content Here</h2>
    </div>
  </div>
</section>`})})]}),r.jsxs("section",{id:"animation-effects",className:"mb-12",children:[r.jsxs("div",{className:"flex items-center mb-6",children:[r.jsx("h2",{className:"text-xl sm:text-2xl font-medium text-neutral-900 dark:text-neutral-100 transition-colors duration-300",children:"Animation & Interactive Effects"}),r.jsx("div",{className:"ml-4 h-0.5 flex-1 bg-neutral-200 dark:bg-neutral-700 transition-colors duration-300"})]}),r.jsx(NX,{title:"Bring Static Designs to Life",description:"Subtle animations and interactions are what separate professional designs from amateur ones. They guide user attention, provide feedback, and create memorable experiences.",icon:F4,examples:["Fade-in sequences for content reveal","Hover effects for interactive elements","Loading animations for better UX","Smooth transitions between states"]}),r.jsxs("div",{className:"mt-6",children:[r.jsx("h4",{className:"text-lg font-medium text-gray-900 dark:text-white mb-3",children:"Animation Categories:"}),r.jsxs("div",{className:"grid gap-6 md:grid-cols-2",children:[r.jsxs("div",{className:"space-y-4",children:[r.jsx("h5",{className:"font-medium text-gray-900 dark:text-white",children:"Entrance Animations:"}),r.jsx(z1e,{language:"css",children:`/* Fade In */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.6s ease-out;
}

/* Slide In */
@keyframes slideIn {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}

.slide-in {
  animation: slideIn 0.8s ease-out;
}`})]}),r.jsxs("div",{className:"space-y-4",children:[r.jsx("h5",{className:"font-medium text-gray-900 dark:text-white",children:"Interaction Animations:"}),r.jsx(z1e,{language:"css",children:`/* Button Hover */
.button-hover {
  transition: all 0.3s ease;
}

.button-hover:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

/* Card Float */
.card-float:hover {
  transform: translateY(-5px) scale(1.02);
  transition: all 0.3s ease;
}`})]})]})]}),r.jsx("div",{className:"mt-6",children:r.jsxs("div",{className:"bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6",children:[r.jsx("h4",{className:"text-lg font-medium text-blue-900 dark:text-blue-100 mb-3",children:"Animation Best Practices:"}),r.jsxs("div",{className:"grid gap-4 md:grid-cols-2",children:[r.jsxs("div",{children:[r.jsx("h5",{className:"font-medium text-blue-900 dark:text-blue-100 mb-2",children:"Do:"}),r.jsxs("ul",{className:"text-sm text-blue-800 dark:text-blue-200 space-y-1",children:[r.jsx("li",{children:"• Use subtle, purposeful animations"}),r.jsx("li",{children:"• Keep durations under 0.5s for UI feedback"}),r.jsx("li",{children:"• Provide animation controls for accessibility"}),r.jsx("li",{children:"• Test performance on slower devices"})]})]}),r.jsxs("div",{children:[r.jsx("h5",{className:"font-medium text-blue-900 dark:text-blue-100 mb-2",children:"Avoid:"}),r.jsxs("ul",{className:"text-sm text-blue-800 dark:text-blue-200 space-y-1",children:[r.jsx("li",{children:"• Excessive or distracting animations"}),r.jsx("li",{children:"• Auto-playing content without controls"}),r.jsx("li",{children:"• Animations that interfere with usability"}),r.jsx("li",{children:"• Heavy effects that slow page load"})]})]})]})]})})]}),r.jsxs("section",{id:"component-enhancement",className:"mb-12",children:[r.jsxs("div",{className:"flex items-center mb-6",children:[r.jsx("h2",{className:"text-xl sm:text-2xl font-medium text-neutral-900 dark:text-neutral-100 transition-colors duration-300",children:"Component Enhancement with UIVerse"}),r.jsx("div",{className:"ml-4 h-0.5 flex-1 bg-neutral-200 dark:bg-neutral-700 transition-colors duration-300"})]}),r.jsx(NX,{title:"Replace Generic Components with Custom Designs",description:"Default AI buttons and cards are forgettable. UIVerse provides thousands of beautifully designed, interactive components that you can easily integrate into your AI-generated layouts.",icon:$S