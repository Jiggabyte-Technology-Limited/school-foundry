 that 4. Ensure adequate spacing between components (16px) and proper padding within cards (16px). Use a clean design with subtle borders (#F0F0F0), light gray backgrounds (#F9F9F9) for cards, and a white (#FFFFFF) main background. Make it responsive with appropriate stacking on tablet and mobile views."})})]}),r.jsxs("div",{className:"bg-gray-50 dark:bg-neutral-800/30 rounded-lg p-4 transition-colors duration-300",children:[r.jsx("h3",{className:"font-medium text-gray-800 dark:text-white text-lg mb-2 transition-colors duration-300",children:"E-commerce Product Page"}),r.jsxs("div",{className:"mb-4 border border-gray-200 dark:border-neutral-700 rounded-lg overflow-hidden",children:[r.jsx("div",{className:"bg-white dark:bg-neutral-900/30 p-3 flex justify-center",children:r.jsxs("div",{className:"h-40 flex flex-col sm:flex-row gap-3 w-full max-w-[320px]",children:[r.jsxs("div",{className:"w-full sm:w-1/2 flex flex-col gap-1",children:[r.jsx("div",{className:"flex-1 bg-gray-100/70 dark:bg-neutral-800/70 rounded"}),r.jsx("div",{className:"h-6 flex gap-1",children:[1,2,3,4].map(W=>r.jsx("div",{className:"flex-1 bg-gray-200/60 dark:bg-neutral-700/60 rounded"},W))})]}),r.jsxs("div",{className:"w-full sm:w-1/2 flex flex-col gap-1",children:[r.jsx("div",{className:"h-3 w-3/4 bg-gray-800/80 dark:bg-gray-200/80 rounded"}),r.jsx("div",{className:"flex items-center gap-2",children:r.jsx("div",{className:"h-2 w-12 bg-green-500/40 dark:bg-green-600/40 rounded"})}),r.jsx("div",{className:"h-2 w-full bg-gray-300/80 dark:bg-gray-700/80 rounded"}),r.jsx("div",{className:"h-2 w-5/6 bg-gray-300/80 dark:bg-gray-700/80 rounded"}),r.jsx("div",{className:"flex gap-1 mt-1",children:["S","M","L","XL"].map(W=>r.jsx("div",{className:"w-5 h-5 border border-gray-200/80 dark:border-neutral-700/80 rounded flex items-center justify-center text-[8px] text-gray-500 dark:text-gray-400",children:W},W))}),r.jsx("div",{className:"mt-auto h-5 w-full bg-blue-500/40 dark:bg-blue-600/40 rounded flex items-cen