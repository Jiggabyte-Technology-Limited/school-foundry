  @keyframes fadeInSlideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
      backdrop-filter: blur(0px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      backdrop-filter: blur(12px);
    }
  }
  
  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
