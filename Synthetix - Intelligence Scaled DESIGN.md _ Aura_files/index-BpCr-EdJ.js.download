  font-weight: 400;
  line-height: 1.6;
}`})})]}),r.jsxs("section",{id:"color-transformation",className:"mb-12",children:[r.jsxs("div",{className:"flex items-center mb-6",children:[r.jsx("h2",{className:"text-xl sm:text-2xl font-medium text-neutral-900 dark:text-neutral-100 transition-colors duration-300",children:"Color & Theme Transformation"}),r.jsx("div",{className:"ml-4 h-0.5 flex-1 bg-neutral-200 dark:bg-neutral-700 transition-colors duration-300"})]}),r.jsx(NX,{title:"Escape the Purple Gradient Trap",description:"AI tools default to purple gradients because they're 'safe.' But safe doesn't command attention or create memorable brands. Strategic color choices can instantly elevate your design's personality.",icon:Xm,examples:["One-click light to dark mode switching","Smart color selection across elements","Consistent theme application","Brand-specific color customization"]}),r.jsxs("div",{className:"mt-6",children:[r.jsx("h4",{className:"text-lg font-medium text-gray-900 dark:text-white mb-3",children:"Color Palette Alternatives:"}),r.jsxs("div",{className:"grid gap-4 md:grid-cols-2 lg:grid-cols-4",children:[r.jsxs("div",{className:"bg-gradient-to-br from-orange-400 to-pink-500 rounded-lg p-4 text-white",children:[r.jsx("h5",{className:"font-medium mb-1",children:"Sunset"}),r.jsx("p",{className:"text-xs opacity-90",children:"Warm, energetic, creative"})]}),r.jsxs("div",{className:"bg-gradient-to-br from-emerald-400 to-teal-600 rounded-lg p-4 text-white",children:[r.jsx("h5",{className:"font-medium mb-1",children:"Emerald"}),r.jsx("p",{className:"text-xs opacity-90",children:"Fresh, natural, growth"})]}),r.jsxs("div",{className:"bg-gradient-to-br from-amber-400 to-orange-600 rounded-lg p-4 text-white",children:[r.jsx("h5",{className:"font-medium mb-1",children:"Amber"}),r.jsx("p",{className:"text-xs opacity-90",children:"Confident, premium, warm"})]}),r.jsxs("div",{className:"bg-gradient-to-br from-sky-400 to-blue-600 rounded-lg p-4 text-white",children:[r.jsx("h5",{className:"font-medium mb-1",child