  if (typeof document === "undefined") {
    return;
  }

  const targets = [
    document.documentElement,
    document.body,
    document.getElementById("root"),
  ].filter(Boolean);

  for (const target of targets) {
    target.classList.add("__aura-tailwind-kick");
  }

  window.requestAnimationFrame(() => {
    for (const target of targets) {
      target.classList.remove("__aura-tailwind-kick");
    }
  });
};

const attachTailwindPreviewObserver = () => {
  if (window.__auraTailwindPreviewObserver || typeof MutationObserver === "undefined") {
    return;
  }

  const observer = new MutationObserver(() => {
    window.requestAnimationFrame(kickTailwindPreview);
  });

  observer.observe(document.documentElement, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ["class"],
  });

  window.__auraTailwindPreviewObserver = observer;
};

const loadTailwindPreview = () => {
  if (typeof document === "undefined") {
    return;
  }

  const existingScript = document.querySelector('script[data-aura-tailwind-preview="true"]');

  if (existingScript) {
    if (existingScript.dataset.loaded === "true") {
      kickTailwindPreview();
      window.setTimeout(kickTailwindPreview, 120);
      attachTailwindPreviewObserver();
    }
    return;
  }

  const script = document.createElement("script");
  script.src = "https://cdn.tailwindcss.com";
  script.async = true;
  script.dataset.auraTailwindPreview = "true";
  script.onload = () => {
    script.dataset.loaded = "true";
    kickTailwindPreview();
    window.setTimeout(kickTailwindPreview, 0);
    window.setTimeout(kickTailwindPreview, 120);
    window.setTimeout(kickTailwindPreview, 320);
    attachTailwindPreviewObserver();
  };
  document.head.appendChild(script);
