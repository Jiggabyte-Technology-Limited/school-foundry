]})]})]}),r.jsx("div",{className:"hidden xl:block w-64 shrink-0",children:r.jsx("div",{className:"sticky top-24",children:r.jsx(Nm,{items:i,activeSection:e,onSectionClick:l})})})]})})})})]})},tUa="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/learn-assets/seo-settings/2026-05-05",s4=e=>`${tUa}/${e}`,zGt=[{question:"How do I add SEO to my Aura website?",answer:"Open the Publish popover, switch to the SEO tab, choose Home or a specific page, then fill in the title, keywords, description, favicon, and any page-specific overrides before publishing."},{question:"Do I need to edit the website header manually?",answer:"No. For normal SEO metadata, use the Publish SEO tab. Aura stores SEO fields with the published project so they survive republishing, page changes, and domain updates."},{question:"Can I customize SEO for each page?",answer:"Yes. Use the Page dropdown inside the SEO tab. Home works as the site default, and individual pages can have their own title, keywords, description, and social preview image."},{question:"What should I write in the SEO title?",answer:"Write a clear promise for the specific page, then add the brand when it helps recognition. Avoid generic titles like Home, Landing Page, or Page 1."},{question:"What should I check after publishing?",answer:"Check the public page, robots.txt, sitemap.xml, and llms.txt when available. Then verify the domain in Google Search Console, submit the sitemap, and inspect the most important URLs."},{question:"Does a custom domain help SEO?",answer:"A custom domain is not a ranking strategy by itself, but it gives the site a memorable canonical home. Pick one primary host and use it consistently in links, Search Console, and the sitemap."}],rUa=[{title:"Title",icon:tg,description:"Use the actual promise of the page, not a file label. Put the specific topic near the front and include the brand when it improves recognition.",example:"Flowly - SaaS Workflow Builder Template"},{title:"Description",icon:Mu,description:"Explain what the page is, who it is for, and why someone should click. Keep it specific without making it sound mechanical.",example:"A SaaS landing page template for workflow automation teams, with pricing sections, product screenshots, testimonials, and conversion-focused copy."},{title:"Keywords",icon:ZAe,description:"Use a short comma-separated topic list that actually matches the page. Treat keywords as support, not as a replacement for useful page copy.",example:"SaaS landing page, workflow builder, automation template"}],nUa=[{page:"Home",intent:"Brand/category",title:"What the site is",description:"Broad promise"},{page:"Pricing",intent:"Buying",title:"Plan details",description:"Trial, price, guarantee"},{page:"Templates",intent:"Discovery",title:"Collection/category",description:"What users can browse"},{page:"Case study",intent:"Proof",title:"Outcome/customer",description:"Measurable result"},{page:"Blog",intent:"Education",title:"Question/problem",description:"Practical answer"}],aUa=["Project title and description","Default SEO title, description, and keywords","Page-specific SEO overrides","Social preview image data","Light and dark favicons","Google Analytics or Google Tag Manager IDs","Custom domain and public visibility"],sUa=["The homepage has a specific title, not just the brand name.","Every important page has a unique title and description.","Keywords are comma-separated and not stuffed.","The visible H1 agrees with the SEO title.","The page copy includes real audience, category, and offer language.","Images appear near relevant text and have useful alt text when exported or edited.","The favicon is recognizable in small browser tabs.","The social preview image is readable when cropped.","The page is public, not private.","The custom domain is the URL you want people to share.","You chose one canonical host, such as example.com or www.example.com.","The sitemap loads at the canonical domain.","robots.txt is not blocking the site.","Search Console ownership is verified.","The sitemap is submitted in Search Console.","The homepage and key pages pass URL Inspection.","Google Analytics or GTM is added only if you need behavior tracking.","The site has links from places real users can find it."],iUa=[{label:"Google Search Essentials",url:"https://developers.google.com/search/docs/essentials"},{label:"Google SEO Starter Guide",url:"https://developers.google.com/search/docs/fundamentals/seo-starter-guide"},{label:"Verify your site ownership in Search Console",url:"https://support.google.com/webmasters/answer/9008080?hl=en"},{label:"URL Inspection tool",url:"https://support.google.com/webmasters/answer/9012289?hl=en"},{label:"Build and submit a sitemap",url:"https://developers.google.com/search/docs/crawling-indexing/sitemaps/build-sitemap"},{label:"Canonical URL guidance",url:"https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls"}],i4=({src:e,alt:t})=>r.jsx("figure",{className:"my-10 overflow-hidden rounded-xl border border-neutral-200 bg-neutral-50 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/40",children:r.jsx("img",{src:e,alt:t,className:"block aspect-video w-full object-cover",loading:"lazy",decoding:"async"})}),o4=({id:e,title:t,icon:n})=>r.jsx("div",{id:e,className:"scroll-mt-28 pt-3",children:r.jsxs("div",{className:"mb-6 flex items-center",children:[r.jsx("div",{className:"mr-3 flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 bg-white text-neutral-700 shadow-sm dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300",children:r.jsx(n,{className:"h-4 w-4",strokeWidth:1.6})}),r.jsx("h2",{className:"text-xl font-medium tracking-tight text-neutral-900 transition-colors duration-300 sm:text-2xl dark:text-neutral-100",children:t}),r.jsx("div",{className:"ml-4 h-px flex-1 bg-neutral-200 transition-colors duration-300 dark:bg-neutral-800"})]})}),b9e=({items:e})=>r.jsx("div",{className:"grid gap-3",children:e.map(t