              font-size: 14px !important;
              display: flex !important;
              align-items: center !important;
              gap: 6px !important;
            }
            .edit-mode-instructions p {
              margin: 0 !important;
              line-height: 1.4 !important;
            }
            .edit-mode-inline-edit {
              background: rgba(59, 130, 246, 0.1) !important;
              border: none !important;
              border-radius: 0 !important;
              padding: 0 !important;
              margin: 0 !important;
              outline: none !important;
              font-family: inherit !important;
              font-size: inherit !important;
              font-weight: inherit !important;
              color: inherit !important;
              line-height: inherit !important;
              text-align: inherit !important;
              text-transform: inherit !important;
              letter-spacing: inherit !important;
              min-width: 100px !important;
              box-shadow: none !important;
              -webkit-appearance: none !important;
              -moz-appearance: none !important;
              appearance: none !important;
              border-width: 0 !important;
              border-style: none !important;
              border-color: transparent !important;
              outline-width: 0 !important;
              outline-style: none !important;
              outline-color: transparent !important;
              resize: none !important;
              overflow: hidden !important;
            }
            .edit-mode-inline-edit:focus {
              background: rgba(59, 130, 246, 0.1) !important;
              box-shadow: none !important;
              border: none !important;
              outline: none !important;
              border-width: 0 !important;
              border-style: none !important;
              border-color: transparent !important;
              outline-width: 0 !important;
              outline-style: none !important;
              outline-color: transparent !important;
              resize: none !important;
              overflow: hidden !important;
            }
            
            /* Override opacity: 0, blur, and transform for animation-related elements in Design Mode */
            /* Direct class overrides for common animation classes that set opacity: 0 via CSS */
            .reveal,
            .fade,
            .fadeIn,
            .fade-in,
            .slideIn,
            .slide-in,
            .slideUp,
            .slide-up,
            .animate,
            [class*="reveal"],
            [class*="fade-in"],
            [class*="slide-in"],
            [class*="animate-on"] {
              opacity: 1 !important;
              filter: none !important;
              transform: none !important;
            }
            /* Inline style overrides */
            [class*="animate"][style*="opacity: 0"],
            [class*="animate"][style*="opacity:0"],
            [class*="animation"][style*="opacity: 0"],
            [class*="animation"][style*="opacity:0"],
            [class*="reveal"][style*="opacity: 0"],
            [class*="reveal"][style*="opacity:0"],
            [class*="fade"][style*="opacity: 0"],
            [class*="fade"][style*="opacity:0"],
            [class*="Fade"][style*="opacity: 0"],
            [class*="Fade"][style*="opacity:0"],
            [class*="slide"][style*="opacity: 0"],
            [class*="slide"][style*="opacity:0"],
            [class*="Slide"][style*="opacity: 0"],
            [class*="Slide"][style*="opacity:0"] {
              opacity: 1 !important;
            }
            [class*="animate"].opacity-0,
            [class*="animation"].opacity-0,
            [class*="reveal"].opacity-0,
            [class*="fade"].opacity-0,
            [class*="Fade"].opacity-0,
            [class*="slide"].opacity-0,
            [class*="Slide"].opacity-0 {
              opacity: 1 !important;
            }
          </style>
        </head>
        <body>
          <div class="edit-mode-instructions">
            <h4>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="m18.5 2.5 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
              Edit Mode
            </h4>
            <p>Hover over elements to highlight them. Click to edit text content and Tailwind classes. Double-click to edit text inline. Press Cmd+C to copy, Cmd+X to cut, Cmd+V to paste into selected DIV, Cmd+D to duplicate selected element, Delete/Backspace to delete selected element.</p>
          </div>
          ${tu}
        </body>
        </html>
