        @keyframes fadePreview {
          from { opacity: 0.3; }
          to { opacity: 1; }
        }
        
        @keyframes slidePreview {
          from { transform: translateX(-10px); }
          to { transform: translateX(10px); }
        }
        
        @keyframes scalePreview {
          from { transform: scale(0.5); }
          to { transform: scale(1.2); }
        }
        
        @keyframes rotatePreview {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }
        
        @keyframes blurPreview {
          from { filter: blur(3px); }
          to { filter: blur(0); }
        }
        
        @keyframes threeDPreview {
          from { transform: perspective(100px) rotateY(45deg); }
          to { transform: perspective(100px) rotateY(-45deg); }
        }
        
        @keyframes pulsePreview {
          0% { transform: scale(1); }
          50% { transform: scale(1.2); }
          100% { transform: scale(1); }
        }
        
        @keyframes shakePreview {
          0% { transform: translateX(0); }
          25% { transform: translateX(-3px); }
          50% { transform: translateX(0); }
          75% { transform: translateX(3px); }
          100% { transform: translateX(0); }
        }
        
        @keyframes bouncePreview {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-10px); }
        }
        
        @keyframes moveRightLinear {
          from { transform: translateX(-15px); }
          to { transform: translateX(15px); }
        }
        
        @keyframes moveRightEase {
          from { transform: translateX(-15px); }
          to { transform: translateX(15px); }
        }
        
        @keyframes moveRightEaseIn {
          from { transform: translateX(-15px); }
          to { transform: translateX(15px); }
        }
        
        @keyframes moveRightEaseOut {
          from { transform: translateX(-15px); }
          to { transform: translateX(15px); }
        }
        
        @keyframes moveRightEaseInOut {
          from { transform: translateX(-15px); }
          to { transform: translateX(15px); }
        }
        
        @keyframes moveRightSpring {
          0% { transform: translateX(-15px); }
          80% { transform: translateX(18px); }
          90% { transform: translateX(12px); }
          100% { transform: translateX(15px); }
        }
        
        @keyframes moveRightBounce {
          0% { transform: translateX(-15px); }
          70% { transform: translateX(17px); }
          85% { transform: translateX(13px); }
          100% { transform: translateX(15px); }
        }
        
        @keyframes moveRightNormal {
          from { transform: translateX(-15px); }
          to { transform: translateX(15px); }
        }
        
        @keyframes moveLeftReverse {
          from { transform: translateX(15px); }
          to { transform: translateX(-15px); }
        }
        
        @keyframes moveAlternate {
          0% { transform: translateX(-15px); }
          50% { transform: translateX(15px); }
          100% { transform: translateX(-15px); }
        }
        
        @keyframes moveAlternateReverse {
          0% { transform: translateX(15px); }
          50% { transform: translateX(-15px); }
          100% { transform: translateX(15px); }
        }
      `})]})},mdt=class mdt{constructor(){Af(this,"_templates",[]);Af(this,"_isLoading",!1);Af(this,"_errorMessage",null);Af(this,"_selectedTemplate",null);Af(this,"categories",["Hero","Features","Testimonial","Pricing","Modal","Login","Sidebar","Onboarding","Grid","Payment","3D"])}static get shared(){return this._instance||(this._instance=new mdt),this._instance}get templates(){return this._templates}set templates(t){this._templates=t}get isLoading(){return this._isLoading}set isLoading(t){this._isLoading=t}get errorMessage(){return this._errorMessage}set errorMessage(t){this._errorMessage=t}get selectedTemplate(){return this._selectedTemplate}set selectedTemplate(t){this._selectedTemplate=t}async loadTemplates(t){this._isLoading=!0,this._errorMessage=null;try{const n=[],a=await Kde({category:"All",page:1,limit:50,search:(t==null?void 0:t.trim())||"",sortBy:"created_at",sortDirection:"desc",includeFeaturedOnly:!0,includeCode:!1,minViews:50});if(a.success&&a.data&&a.data.length>0){const i=a.data.map(l=>({id:l.id,slug:l.slug,title:l.title,code:"",language:"html",username:l.authorName,userId:"",createdAt:new Date(l.created_at),views:l.views,forks:l.forks||0,imageUrl:l.src||l.image_url,isPrivate:!1,category:l.category,tags:l.tags||[],description:l.description,authorFullName:l.authorName,authorAvatarUrl:l.avatarUrl,authorSlug:l.userSlug,premium:l.premium||!1}));n.push(...i)}this._templates=n,this._templates.length===0&&this.loadSampleTemplates(),this._isLoading=!1}catch(n){this._errorMessage=`Failed to load templates: ${n instanceof Error?n.message:"Unknown error"}`,this._isLoading=!1,this.loadSampleTemplates()}}loadSampleTemplates(){this._templates=[{id:4,slug:"dashboard-layout",title:"Admin Dashboard Layout",code:`<div class="dashboard">
          <nav class="sidebar">
            <div class="logo">
              <img src="logo.svg" alt="Logo" />
            </div>
            <ul class="menu">
              <li class="active"><a href="#">Dashboard</a></li>
              <li><a href="#">Analytics</a></li>
              <li><a href="#">Orders</a></li>
              <li><a href="#">Customers</a></li>
              <li><a href="#">Products</a></li>
              <li><a href="#">Settings</a></li>
            </ul>
            <div class="user-profile">
              <img src="avatar.jpg" alt="User" />
              <div>
                <p class="name">John Doe</p>
                <p class="role">Administrator</p>
              </div>
            </div>
          </nav>
          <main class="content">
            <header class="content-header">
              <h1>Dashboard Overview</h1>
              <div class="actions">
                <button>Export</button>
                <button class="primary">New Report</button>
              </div>
            </header>
            <div class="stats-cards">
              <div class="stat-card">
                <h3>Total Sales</h3>
                <p class="value">$48,294</p>
                <p class="change positive">+12.5%</p>
              </div>
              <div class="stat-card">
                <h3>Visitors</h3>
                <p class="value">12,845</p>
                <p class="change positive">+8.3%</p>
              </div>
              <div class="stat-card">
                <h3>Orders</h3>
                <p class="value">1,284</p>
                <p class="change negative">-2.1%</p>
              </div>
              <div class="stat-card">
                <h3>Conversion</h3>
                <p class="value">9.8%</p>
                <p class="change positive">+1.2%</p>
              </div>
            </div>
          </main>
        </div>`,language:"html",username:"dashboardking",userId:"user-101",createdAt:new Date(Date.now()-60*60*24*20*1e3),views:4156,forks:257,imageUrl:"https://aura.build/storage/preview-images/dashboard-layout.jpg",isPrivate:!1,category:"Dashboard",tags:["dashboard","admin","analytics"],description:"A modern dashboard layout with analytics and sales tracking",authorFullName:"John Doe",authorAvatarUrl:"https://aura.build/storage/avatars/john_doe.jpg",authorSlug:"dashboardking",premium:!1},{id:3,slug:"login-form",title:"Modern Login Form",code:`<div class="login-container">
          <div class="login-header">
            <h2>Welcome Back</h2>
            <p>Please enter your credentials</p>
          </div>
          <form class="login-form">
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" placeholder="your@email.com" required />
            </div>
            <div class="form-group">
              <label for="password">Password</label>
              <input type="password" id="password" placeholder="••••••••" required />
              <a href="#" class="forgot-password">Forgot password?</a>
            </div>
            <button type="submit" class="login-button">Sign In</button>
            <div class="social-login">
              <button type="button" class="google-login">Continue with Google</button>
              <button type="button" class="apple-login">Continue with Apple</button>
            </div>
