                    .loading-button {
                      position: relative;
                      min-width: 100px;
                    }
                    .loading-spinner {
                      display: none;
                      position: absolute;
                      width: 20px;
                      height: 20px;
                      top: calc(50% - 10px);
                      left: calc(50% - 10px);
                      border: 2px solid rgba(255,255,255,0.3);
                      border-radius: 50%;
                      border-top-color: white;
                      animation: spin 0.8s linear infinite;
                      opacity: 0;
                      transition: opacity 0.3s ease;
