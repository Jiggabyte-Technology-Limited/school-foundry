ldren:"Aura can generate basic metadata, but generated SEO should be treated like a first draft. It may understand the visual intent of the page, but it does not always know the market, buyer, category, brand positioning, or phrases people use when they search."}),r.jsx("p",{children:"Use the Home option as the default SEO for the site. Then override individual pages when their search intent is different. If a page would deserve a different search result on Google, it deserves different SEO in Aura."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"behind-scenes",title:"What Aura Publishes Behind the Scenes",icon:Wu}),r.jsx(i4,{src:s4("publish-pipeline-v2.png"),alt:"Flow from Aura project pages to metadata storage, edge injection, and search crawlers"}),r.jsx("p",{children:"The current Aura publishing flow stores the important SEO pieces separately from the design files:"}),r.jsx("div",{className:"not-prose my-7 rounded-lg border border-neutral-200 bg-neutral-50 p-5 dark:border-neutral-800 dark:bg-neutral-900/40",children:r.jsx(b9e,{items:aUa})}),r.jsx("p",{children:"That separation matters because a published website has two audiences: people who see the page itself, and crawlers or preview bots that need reliable metadata before rendering a search result, social card, link preview, or indexed URL."}),r.jsx("p",{children:"You still need strong visible content on the page. Metadata can influence how a result appears, but it cannot compensate for a page that is vague, thin, inaccessible, or disconnected from the search query."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"titles",title:"Write Titles Like Promises, Not Labels",icon:tg}),r.jsx(i4,{src:s4("title-snippet-v2.png"),alt:"Search result card showing a useful title, domain, and snippet"}),r.jsx("p",{children:"The title is usually the most important field you will write in the SEO tab. It becomes the strongest hint for the search result title, browser tab, saved bookmarks, and link previews."}),r.jsxs("div",{className:"not-prose my-7 grid gap-4 md:grid-cols-2",children:[r.jsxs("div",{className:"rounded-lg border border-red-100 bg-red-50/70 p-5 text-sm text-red-950 dark:border-red-900/40 dark:bg-red-950/20 dark:text-red-100",children:[r.jsx("p",{className:"mb-3 font-medium",children:"Weak labels"}),r.jsxs("ul",{className:"space-y-2",children:[r.jsx("li",{children:"Home"}),r.jsx("li",{children:"Landing Page"}),r.jsx("li",{children:"SaaS Template"}),r.jsx("li",{children:"My Portfolio"})]})]}),r.jsxs("div",{className:"rounded-lg border border-emerald-100 bg-emerald-50/80 p-5 text-sm text-emerald-950 dark:border-emerald-900/40 dark:bg-emerald-950/20 dark:text-emerald-100",children:[r.jsx("p",{className:"mb-3 font-medium",children:"Strong promises"}),r.jsxs("ul",{className:"space-y-2",children:[r.jsx("li",{children:"Flowly - SaaS Workflow Builder Template"}),r.jsx("li",{children:"Private Chef Portfolio for Luxury Events"}),r.jsx("li",{children:"AI Resume Builder for Product Managers"}),r.jsx("li",{children:"Singapore Wedding Photographer With Editorial Style"})]})]})]}),r.jsx("p",{children:"Use this formula for most Aura pages:"}),r.jsx("p",{children:r.jsx("code",{children:"Page-specific promise - brand or site name"})}),r.jsx("p",{children:"Keep the title readable. Do not turn it into a pile of keywords. A person should be able to scan it and understand why the page exists."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"descriptions",title:"Write Descriptions That Sell the Click",icon:Mu}),r.jsx(i4,{src:s4("description-board-v2.png"),alt:"Snippet writing board with problem, audience, outcome, and proof blocks"}),r.jsx("p",{children:"The description field should explain what the page is, who it is for, and why someone should click. A good description is the tiny sales pitch that sits under the search result."}),r.jsx("p",{children:"Use this pattern:"}),r.jsx("p",{children:r.jsx("code",{children:"For [audience], this page helps you [outcome] with [specific proof, format, or feature]."})}),r.jsx("div",{className:"not-prose my-7 grid gap-4",children:rUa.map(i=>{const l=i.icon;return r.jsx("div",{className:"rounded-lg border border-neutral-200 bg-white p-5 transition-colors duration-300 dark:border-neutral-800 dark:bg-neutral-900/30",children:r.jsxs("div",{className:"flex items-start gap-4",children:[r.jsx("div",{className:"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-neutral-700 transition-colors duration-300 dark:bg-neutral-800 dark:text-neutral-300",children:r.jsx(l,{className:"h-5 w-5",strokeWidth:1.5})}),r.jsxs("div",{children:[r.jsx("h3",{className:"mb-2 text-lg font-medium text-neutral-900 transition-colors duration-300 dark:text-neutral-100",children:i.title}),r.jsx("p",{className:"text-base leading-relaxed text-neutral-600 transition-colors duration-300 dark:text-neutral-400",children:i.description}),r.jsx("div",{className:"mt-4 rounded-md border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 transition-colors duration-300 dark:border-neutral-800 dark:bg-neutral-950/50 dark:text-neutral-300",children:i.example})]})]})},i.title)})}),r.jsx("p",{children:"Before publishing, read your title and description together. Ask whether the result would feel specific, trustworthy, and meaningfully different beside competitors."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"page-specific",title:"Use Page-Specific SEO for Multi-Page Sites",icon:oP}),r.jsx(i4,{src:s4("page-specific-seo-v2.png"),alt:"Site map showing Home, Pricing, Blog, About, and Contact pages with different SEO cards"}),r.jsx("p",{children:"Aura's SEO tab has a Page dropdown. This is easy to miss, but it is the difference between basic SEO and useful SEO. Home is the broad default. Important pages should get their own search result."}),r.jsx("div",{className:"not-prose my-7 overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800",children:r.jsx("div",{className:"overflow-x-auto",children:r.jsxs("table",{className:"min-w-full divide-y divide-neutral-200 text-left text-sm dark:divide-neutral-800",children:[r.jsx("thead",{className:"bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 dark:bg-neutral-900/50 dark:text-neutral-400",children:r.jsxs("tr",{children:[r.jsx("th",{className:"px-4 py-3 font-medium",children:"Page"}),r.jsx("th",{className:"px-4 py-3 font-medium",children:"Search Intent"}),r.jsx("th",{className:"px-4 py-3 font-medium",children:"Title Angle"}),r.jsx("th",{className:"px-4 py-3 font-medium",children:"Description Angle"})]})}),r.jsx("tbody",{className:"divide-y divide-neutral-200 bg-white dark:divide-neutral-800 dark:bg-neutral-950",children:nUa.map(i=>r.jsxs("tr",{children:[r.jsx("td",{className:"px-4 py-3 font-medium text-neutral-900 dark:text-neutral-100",children:i.page}),r.jsx("td",{className:"px-4 py-3 text-neutral-600 dark:text-neutral-400",children:i.intent}),r.jsx("td",{className:"px-4 py-3 text-neutral-600 dark:text-neutral-400",children:i.title}),r.jsx("td",{className:"px-4 py-3 text-neutral-600 dark:text-neutral-400",children:i.description})]},i.page))})]})})}),r.jsx("p",{children:"Use page-specific SEO when a page targets a different query, audience, question, share preview, or buying intent."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"content-match",title:"Make the Page Match the Metadata",icon:Oy}),r.jsx(i4,{src:s4("content-alignment-v2.png"),alt:"Metadata card connected to headings, body copy, images, and links on a page"}),r.jsx("p",{children:'Metadata works best when it agrees with the page. If the SEO title says "AI Website Builder for SaaS Startups," the page should visibly include those ideas in natural places.'}),r.jsx("div",{className:"not-prose my-7 rounded-lg border border-neutral-200 bg-neutral-50 p-5 dark:border-neutral-800 dark:bg-neutral-900/40",children:r.jsx(b9e,{items:["The H1 or main hero heading","The opening paragraph","Section headings","Alt text for relevant images","Button and link labels","FAQ questions","Case studies or examples"]})}),r.jsx("p",{children:"Do not hide all important meaning inside images. Aura can make beautiful visuals, but search engines need text they can read. For AI answer engines, clear headings, direct answers, visible facts, and well-structured sections make the page easier to understand and cite."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"domains",title:"Domains, Slugs, Canonicals, and Duplicates",icon:UN}),r.jsx(i4,{src:s4("domains-canonicals-v2.png"),alt:"Domain routing board comparing Aura subdomain, custom domain, canonical URL, and duplicate copies"}),r.jsx("p",{children:"Domain choices affect how people remember your site and how consistently search engines see your URLs. Pick one primary host and use it consistently in links, social profiles, email signatures, ads, and Search Console."}),r.jsx("p",{children:"For Aura projects, a practical domain strategy is:"}),r.jsx(nPt,{items:["Use the Aura subdomain while drafting and sharing internally.","Move serious public projects to a memorable custom domain when the site is ready.","Verify the domain in Google Search Console.","Submit the sitemap for the canonical domain.","Link to the canonical domain everywhere.","Avoid public duplicate copies on multiple hosts unless canonicalization is handled deliberately."]}),r.jsx("p",{children:"The domain is not the SEO strategy, but it is the address where the strategy compounds."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"images",title:"Images, Favicons, and Social Previews",icon:Gd}),r.jsx(i4,{src:s4("images-social-v2.png"),alt:"Preview image system with favicon, social card, alt text, and image near relevant text"}),r.jsx("p",{children:"Aura's publish flow can capture preview images, upload preview assets, and let you add social image URLs for page-specific SEO. It also supports light and dark favicons in the SEO tab."}),r.jsx("p",{children:"Images need two things for SEO: relevance and context. Use real page screenshots or product visuals when possible, keep social-card text minimal and readable, and choose favicons that stay recognizable at 16x16 and 32x32."}),r.jsx("p",{children:"If you add a page-specific Social Image URL in Aura, use an image that matches that page. A pricing page should not use a generic homepage hero image if the pricing page is what people will share."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"search-console",title:"Search Console Setup After Publishing",icon:nm}),r.jsx(i4,{src:s4("search-console-v2.png"),alt:"Google Search Console workflow with property verification, sitemap submission, and URL inspection"}),r.jsx("p",{children:"Google Webmaster Tools is now Google Search Console. After publishing an Aura site, Search Console is where you verify ownership, submit sitemaps, inspect URLs, and watch how Google sees your pages."}),r.jsx(nPt,{items:["Go to Google Search Console.","Add a Domain property for your root domain, such as example.com.","Copy the TXT verification record.","Add it at your DNS provider.","Wait for DNS propagation.","Click Verify in Search Console.","Submit your sitemap.","Inspect the homepage URL.","Request indexing for the most important pages."]}),r.jsx("p",{children:"Search Console tells you how the site appears in Google Search. Google Analytics tells you what people do after they arrive. Use both when the site is important."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"crawler-checks",title:"Sitemaps, Robots, and Indexing Checks",icon:Oue}),r.jsx(i4,{src:s4("sitemaps-robots-v2.png"),alt:"Crawler checklist showing robots.txt, sitemap.xml, URL Inspection, and index status"}),r.jsx("p",{children:"For published project domains, Aura's edge layer can serve robots.txt, sitemap.xml, and llms.txt. Those files help crawlers understand what they are allowed to fetch and which URLs matter."}),r.jsx("div",{className:"not-prose my-7 grid gap-4 md:grid-cols-3",children:[{label:"robots.txt",body:"Tells crawlers what they may request. It is not a secure way to hide private content."},{label:"sitemap.xml",body:"Lists URLs you want search engines to know about, using fully qualified absolute URLs."},{label:"llms.txt",body:"Gives AI tools a concise map of the site for answer-engine readability."}].map(i=>r.jsxs("div",{className:"rounded-lg border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900/30",children:[r.jsx("p",{className:"mb-2 font-mono text-sm font-medium text-neutral-900 dark:text-neutral-100",children:i.label}),r.jsx("p",{className:"text-sm leading-relaxed text-neutral-600 dark:text-neutral-400",children:i.body})]},i.label))}),r.jsx("p",{children:"After publishing, check these URLs on the canonical host:"}),r.jsxs("ul",{children:[r.jsx("li",{children:r.jsx("code",{children:"https://yourdomain.com/robots.txt"})}),r.jsx("li",{children:r.jsx("code",{children:"https://yourdomain.com/sitemap.xml"})}),r.jsxs("li",{children:[r.jsx("code",{children:"https://yourdomain.com/llms.txt"})," if available"]})]}),r.jsx("p",{children:"For new sites, indexing takes time. Publishing and submitting a sitemap does not guarantee instant ranking. It simply removes avoidable friction."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"measure",title:"Measure, Learn, and Improve",icon:kb}),r.jsx(i4,{src:s4("measurement-loop-v2.png"),alt:"SEO measurement loop from publish to Search Console to content update to republish"}),r.jsx("p",{children:"SEO is not finished on publish day. Publish day is when the feedback loop starts. Search Console can show queries, impressions, click-through behavior, indexing state, canonical choices, and page issues. Analytics can show engagement, sources, CTA clicks, exits, and conversions."}),r.jsx("p",{children:"Then improve the page:"}),r.jsx("div",{className:"not-prose my-7 rounded-lg border border-neutral-200 bg-neutral-50 p-5 dark:border-neutral-800 dark:bg-neutral-900/40",children:r.jsx(b9e,{items:["Rewrite titles with clearer intent.","Make descriptions more specific.","Add real examples and proof.","Add an FAQ section.","Add internal links.","Improve image alt text.","Make the hero clearer.","Remove empty marketing language.","Add location terms for local pages.","Update stale screenshots or pricing references."]})}),r.jsx("p",{children:"SEO rewards compounding clarity. A one-page Aura site can rank if it answers a specific problem better than the alternatives. A large site can fail if every page says vague things in a beautiful layout."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"launch-checklist",title:"A Practical Launch Checklist",icon:yue}),r.jsx(i4,{src:s4("launch-checklist-v2.png"),alt:"Launch checklist with Aura SEO fields, domain, sitemap, Search Console, and measurement"}),r.jsx("p",{children:"Before publishing an Aura site for search, run this checklist:"}),r.jsx("div",{className:"not-prose my-7 rounded-lg border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900/30",children:r.jsx(b9e,{items:sUa})}),r.jsx("p",{children:"The main insight is this: Aura already gives you the publishing surface for SEO. The leverage comes from using it like a strategist, not a form filler."})]}),r.jsxs("section",{className:"mb-14",children:[r.jsx(o4,{id:"references",title:"Official References",icon:qg}),r.jsx(i4,{src:s4("official-references-v2.png"),alt:"Reference shelf with Google Search Central, Search Console, sitemap, and canonical guides"}),r.jsx("p",{children:"Useful Google references for this workflow:"}),r.jsx("div",{className:"not-prose my-7 grid gap-3",children:iUa.map(i=>r.jsxs("a",{href:i.url,target:"_blank",rel:"noreferrer",className:"flex items-center justify-between gap-4 rounded-lg border border-neutral-200 bg-white px-4 py-3 text-sm font-medium text-neutral-800 transition-colors hover:border-emerald-200 hover:bg-emerald-50 dark:border-neutral-800 dark:bg-neutral-900/30 dark:text-neutral-200 dark:hover:border-emerald-900/60 dark:hover:bg-emerald-950/20",children:[r.jsx("span",{children:i.label}),r.jsx(UN,{className:"h-4 w-4 shrink-0 text-neutral-400",strokeWidth:1.6})]},i.url))})]}),r.jsxs("section",{className:"mb-4 scroll-mt-28",children:[r.jsxs("div",{className:"mb-6 flex items-center",children:[r.jsx("h2",{className:"text-xl font-medium tracking-tight text-neutral-900 transition-colors duration-300 sm:text-2xl dark:text-neutral-100",children:"SEO FAQ"}),r.jsx("div",{className:"ml-4 h-px flex-1 bg-neutral-200 transition-colors duration-300 dark:bg-neutral-800"})]}),r.jsx("div",{className:"not-prose my-7 grid gap-4",children:zGt.map(i=>r.jsxs("div",{className:"rounded-lg border border-neutral-200 bg-white p-5 transition-colors duration-300 dark:border-neutral-800 dark:bg-neutral-900/30",children:[r.jsx("h3",{className:"mb-2 text-lg font-medium text-neutral-900 dark:text-neutral-100",children:i.question}),r.jsx("p",{className:"text-base leading-relaxed text-neutral-600 transition-colors duration-300 dark:text-neutral-400",children:i.answer})]},i.question))})]})]}),r.jsx("div",{className:"hidden w-64 shrink-0 xl:block",children:r.jsx("div",{className:"sticky top-24",children:r.jsx(Nm,{items:n,activeSection:e,onSectionClick:a})})})]})})})})]})},y2e=[{id:"aura-basics",title:"Aura basics",icon:Due,description:"Core questions about how Aura works, which models it supports, and how you can get started.",items:[{question:"How does Aura work?",answer:"Aura is a web-based AI design assistant. You can generate HTML, CSS, and JavaScript designs using text prompts, reference templates and components with @, edit visually in Design Mode, and publish or export your creations. All processing happens in your browser and the cloud."},{question:"Can I generate designs with Aura?",answer:"Yes. Aura includes design generation so you can create visual content using text prompts. Pro and Max plans unlock design mode and export options."},{question:"Does Aura work offline?",answer:"No. Aura is a web-based application that requires an internet connection to access AI models and generate content. All processing happens in the cloud for the best performance and latest model access."},{question:"Which AI models does Aura support?",answer:"Aura integrates GPT-5.1, GPT-5, Claude Opus 4.5, Claude Sonnet 4.5, Gemini 3 Pro, and Gemini 2.5 Pro. Pro and Max plans unlock premium models like Claude Opus 4.5, Claude Sonnet 4.5, and Gemini 3 Pro for higher-quality results."},{question:"What apps can Aura integrate with?",answer:"Aura can export designs to Figma using the browser console method, and you can import designs from Figma by pasting Figma URLs. You can also export full sites as HTML/CSS/JS files to continue development in any code editor or deploy to hosting platforms like Netlify or Vercel."},{question:"What are the system requirements for Aura?",answer:"Aura is a web application that works in any modern browser. You'll need a stable internet connection and a modern web browser like Chrome, Firefox, Safari, or Edge. No downloads or installations required—just visit aura.build and start creating."},{question:"Can I try Aura before purchasing?",answer:"Yes. Start a 3-day Pro trial with 20 trial prompts. A payment method is required, and you will not be charged if you cancel before the trial ends."}]},{id:"pricing-billing",title:"Pricing & billing",icon:OP,description:"Plan details, limits, and billing controls drawn from the Pricing and core FAQ content.",items:[{question:"What pricing plans does Aura offer?",answer:"Aura starts with a 3-day Pro trial that includes 20 trial prompts. Paid plans then increase monthly message limits: Pro has 120, Max has 240, and Ultra has 560."},{question:"How do message limits work?",answer:"All AI models (GPT, Claude, Gemini) count toward the same usage limit. The Pro trial includes 20 trial prompts, Pro gets 120 monthly messages after trial, Max gets 240, and Ultra gets 560."},{question:"How does the Pro trial work?",answer:"Pro starts with a 3-day trial and 20 trial prompts. A payment method is required to start; cancel before the trial ends to avoid being charged."},{question:"Can I upgrade or downgrade my plan?",answer:"Yes. Upgrades apply immediately; downgrades take effect at the next billing cycle."},{question:"Do unused messages roll over to the next month?",answer:"No. Message allowances reset each billing cycle for all plans."},{question:"What payment methods do you accept?",answer:"Major credit cards and Apple Pay via Stripe are supported for subscriptions."}]},{id:"features-workflow",title:"Features & workflow",icon:EI,description:"Everything about templates, the editor, and how Aura differs from other tools.",items:[{question:"How do I use @ to reference templates and components?",answer:"Use @ in prompts to pull in templates, components, or snippets—up to ~100,000 characters of context. Shift-click to reference multiple items at once."},{question:"Can I create multi-page websites with Aura?",answer:"Yes. Build as many pages as you need, link elements for navigation, add page transitions, and keep shared components consistent across the site."},{question:"How do I use this template?",answer:"Free or Pro templates can be remixed with the “Use for Free” or “Use as Pro” button. Paid templates require using the author’s “Buy” link to get access."},{question:"Can I customize this template?",answer:"Yes. After remixing or purchasing, you can change colors, fonts, images, layout, and content, or edit the code directly with prompts."},{question:"Do I need Pro to use this template?",answer:"Premium templates require a Pro subscription. Paid templates require purchasing from the author regardless of your plan."},{question:"Can I remix or share my version?",answer:"Yes. You can remix templates to create your own version and share your remixes with the community; credit stays with you."},{question:"Why do elements vanish in Design/Code view?",answer:"Heavy animations can hide elements. Remove or simplify them, or use the built-in Animate Keyframe/Animate on Scroll snippets optimized for the editor."},{question:"What's different from Lovable?",answer:"Aura focuses on Tailwind-based design output: real HTML/CSS/JS, 1,700+ templates, 1,400+ components, multi-page sites, and visual editing. Lovable is more full-stack app–oriented."},{question:"What's different from Framer, Webflow, or Figma Sites?",answer:"Aura outputs standard HTML, Tailwind CSS, and vanilla JS—no proprietary runtime. You can export, self-host, or keep editing in any code editor or Figma."},{question:"Am I tied to Aura when I design and publish?",answer:"No, it's just HTML and you can convert to Figma using our tool, Framer using their plugin and other popular platforms that use HTML."},{question:"Can you import fonts that aren't inside of Aura?",answer:"Yes, you can just mention the font name in the prompt. Or you can do so in the code. As long as it's an online font like Google Fonts, or a URL it'll work."},{question:"My project is resource-intensive and the screen freezes when I try to make changes. What should I do?",answer:'If your page is freezing when trying to make changes, go to Home and click on "Iterations" next to Chat. Hover over the iteration and click on Delete. Before deleting, please copy your code as a backup to avoid any data loss. To optimize your project without editing code, create multiple pages—each new page duplicates the original, which you can then adapt by asking the AI to remove specific sections or unused code. You can also request the AI to remove or adjust animations for improved performance. This approach helps reduce file size and prevent freezing without requiring direct code edits.'},{question:"Why doesn't Aura remember my previous page selections when I switch to a new page?",answer:"Currently, Aura only processes the page you are actively viewing in the editor and does not retain context from previous pages or maintain a full build history. This is intentional to keep performance optimal and avoid overloading the system with too much context. However, when working on a single page, Aura will read up to several thousand lines of that page's HTML to assist you. If you need to reference previously completed sections, it's best to copy any necessary details into the current page's context or provide a summary prompt as you work. We're working on improving context handling in future updates, and your feedback helps prioritize these enhancements."},{question:"How do I design each page separately in Aura and combine them?",answer:`You can prompt and design each page separately in Aura. To connect the pages, use the "Link" feature—right-click an element and choose "Copy," then go to the target page and use "Paste to Replace" as needed. This helps transfer sections or navigation elements across pages. If this workflow doesn't meet your needs, you can download the HTML file from Aura and import it into Cursor. From there, you can prompt Cursor to rebuild or refine the structure as a complete project.`},{question:"I'm trying to add custom logos to the landing page I'm building but I can't figure out how to upload my own assets.",answer:"Currently, direct SVG uploads aren't supported yet. You can, however, copy the SVG code from your file and include it directly in your prompt—even multiple SVGs at once. Alternatively, you could upload your SVG files to an external hosting platform (or FTP server) and reference the public URL in your prompt."}]},{id:"seo-publishing",title:"SEO & publishing",icon:nm,description:"How to add search metadata before publishing and customize it for each page.",items:zGt},{id:"publishing-export",title:"Publishing & export",icon:oP,description:"How to publish, export, host, and connect forms or domains for your projects.",items:[{question:"Can I export this template?",answer:"Yes. After remixing and customizing, you can export as HTML or send to Figma. Export options are available in the editor."},{question:"Can I export my site designs out of Aura?",answer:"Yes. Export full sites as HTML/CSS/JS, publish to subdomains, or export to Figma. All output is standard code you can continue anywhere."},{question:"How do I add my own domain?",answer:"Export your site, deploy to Netlify or Vercel, then configure your custom domain and DNS in their dashboards."},{question:"How do I build multiple pages?",answer:"Create pages in the Pages popover, link elements to pages, and manage navigation. Duplicating a page doesn’t auto-create new ones—you add them explicitly."},{question:"Where should I host my landing page?",answer:"Export HTML and drag-and-drop to Netlify or Vercel. Both have quick, low-setup hosting with free plans."},{question:"Where do form submissions go?",answer:"Forms are empty by default. Connect actions to Netlify Forms, Formspree, Getform, or Google Forms (a few lines of JS) to store submissions."},{question:"What happens to Unicorn Studio animations if servers go down?",answer:"Animated Unicorn Studio assets are hosted on Unicorn Studio by default. If you'd prefer to self-host the assets for more control or reliability, you can follow their official guide: https://www.unicorn.studio/docs/faqs/"}]}],lUa=e=>{const t=/(https?:\/\/[^\s]+)/g;return e.split(t).map((a,i)=>/^https?:\/\//.test(a)?r.jsx("a",{href:a,target:"_blank",rel:"noopener noreferrer",className:"text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 underline transition-colors duration-300",children:a},i):r.jsx("span",{children:a},i))},cUa=({faq:e})=>r.jsxs("div",{className:"bg-white dark:bg-neutral-900/30 border border-gray-200 dark:border-neutral-800 rounded-lg p-5 h-full transition-colors duration-300 shadow-sm",children:[r.jsx("h3",{className:"text-lg sm:text-xl font-medium text-gray-900 dark:text-white mb-2 transition-colors duration-300",childre