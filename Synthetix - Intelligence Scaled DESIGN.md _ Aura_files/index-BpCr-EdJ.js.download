        .section-divider {
          height: 1px;
          background: linear-gradient(
            to right,
            rgba(${ne?"255,255,255":"0,0,0"}, 0.03),
            rgba(${ne?"255,255,255":"0,0,0"}, 0.1),
            rgba(${ne?"255,255,255":"0,0,0"}, 0.03)
          );
          margin: 16px 0;
          position: relative;
        }

        .section-title {
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          background-color: ${ne?"#1f2937":"#fff"};
          padding: 0 10px;
          font-size: 11px;
          color: ${ne?"#999":"#777"};
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }

        .card-container {
          border: ${I==="Transparent"?"none":`1px solid ${I?Be(I,ne?"700":"300"):ne?"rgba(255, 255, 255, 0.1)":"rgba(0, 0, 0, 0.1)"}`};
        }

        .layout-preview {
          border: ${I==="Transparent"?"1px dashed rgba(125, 125, 125, 0.3)":`1px dashed ${I?Be(I,ne?"800":"200"):ne?"#444":"#ddd"}`};
          border-radius: 20px;
          padding: 12px;
          background-color: ${C?Be(C,ne?"900":"100"):ne?"#20222B":"#fafafa"};
          position: relative;
        }

        .layout-block {
          background-color: rgba(59, 130, 246, 0.1);
          border: ${I==="Transparent"?"none":`1px solid ${I?Be(I,ne?"700":"300"):"rgba(59, 130, 246, 0.3)"}`};
          border-radius: 6px;
          height: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          color: ${N?Ce():"#3b82f6"};
          font-size: 12px;
          font-weight: 500;
          font-family: ${te};
        }

        .font-heading {
          font-family: ${Z} !important;
        }

        .font-body {
          font-family: ${te} !important;
        }

        .label {
          position: absolute;
          bottom: -19px;
          left: 0;
          z-index: 10;
          opacity: 0;
          transition: opacity 0.15s ease;
          pointer-events: none;
        }

        .sample-section:hover .label {
          opacity: 1;
        }

        .layout-preview .label {
          bottom: -26px;
          background-color: rgba(0, 0, 0, 0.8);
          border-radius: 12px;
          padding: 4px 10px;
          font-weight: 600;
        }

        .layout-preview:hover .label {
          opacity: 1;
        }

        /* Animation classes */
        @keyframes anim-fade {
          from {
            opacity: 0;
          }
          to {
            opacity: 1;
          }
        }

        @keyframes anim-slide {
          from {
            transform: translateY(20px);
            opacity: 0;
          }
          to {
            transform: translateY(0);
            opacity: 1;
          }
        }

        @keyframes anim-scale {
          from {
            transform: scale(0.8);
            opacity: 0;
          }
          to {
            transform: scale(1);
            opacity: 1;
          }
        }

        @keyframes anim-rotate {
          from {
            transform: rotate(-10deg) scale(0.9);
            opacity: 0;
          }
          to {
            transform: rotate(0) scale(1);
            opacity: 1;
          }
        }

        @keyframes anim-flip {
          from {
            transform: perspective(400px) rotateX(90deg);
            opacity: 0;
          }
          to {
            transform: perspective(400px) rotateX(0);
            opacity: 1;
          }
        }

        @keyframes anim-blur {
          from {
            filter: blur(8px);
            opacity: 0;
          }
          to {
            filter: blur(0);
            opacity: 1;
          }
        }

        @keyframes anim-3d {
          0% {
            transform: perspective(400px) rotateY(30deg) scale(0.8);
            opacity: 0;
          }
          100% {
            transform: perspective(400px) rotateY(0) scale(1);
            opacity: 1;
          }
        }

        @keyframes anim-pulse {
          0% {
            transform: scale(0.95);
            opacity: 0.7;
          }
          50% {
            transform: scale(1.05);
            opacity: 1;
          }
          100% {
            transform: scale(1);
            opacity: 1;
          }
        }

        @keyframes anim-shake {
          0% {
            transform: translateX(0);
            opacity: 0;
          }
          10% {
            opacity: 1;
          }
          10%, 30%, 50%, 70%, 90% {
            transform: translateX(-5px);
          }
          20%, 40%, 60%, 80% {
            transform: translateX(5px);
          }
          100% {
            transform: translateX(0);
            opacity: 1;
          }
        }

        @keyframes anim-bounce {
          0% {
            transform: translateY(0);
            opacity: 0;
          }
          10% {
            opacity: 1;
          }
          40% {
            transform: translateY(-20px);
          }
          60% {
            transform: translateY(-10px);
          }
          80%, 100% {
            transform: translateY(0);
            opacity: 1;
          }
        }

        @keyframes anim-morph {
          0% {
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
            opacity: 0.8;
          }
          50% {
            border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
            opacity: 1;
          }
          100% {
            border-radius: 8px;
            opacity: 1;
          }
        }

        @keyframes anim-skew {
          0% {
            transform: skew(20deg, 0) scale(0.9);
            opacity: 0;
          }
          100% {
            transform: skew(0, 0) scale(1);
            opacity: 1;
          }
        }

        @keyframes anim-color {
          0% {
            color: rgba(59, 130, 246, 0.5);
            background-color: rgba(255, 255, 255, 0);
            opacity: 0.7;
          }
          100% {
            color: inherit;
            background-color: inherit;
            opacity: 1;
          }
        }

        @keyframes anim-hue {
          0% {
            filter: hue-rotate(90deg) saturate(1.5);
            opacity: 0.7;
          }
          100% {
            filter: hue-rotate(0) saturate(1);
            opacity: 1;
          }
        }

        @keyframes anim-perspective {
          0% {
            transform: perspective(500px) rotateX(20deg) rotateY(20deg) scale(0.8);
            opacity: 0;
          }
          100% {
            transform: perspective(500px) rotateX(0) rotateY(0) scale(1);
            opacity: 1;
          }
        }

        @keyframes anim-clip {
          0% {
            clip-path: inset(0 50% 0 50%);
            opacity: 0;
          }
          100% {
            clip-path: inset(0 0 0 0);
            opacity: 1;
          }
        }

        .anim-fade {
          animation: anim-fade ${D}s ${Qe($)} ${F}s ${It(U)} ${Ot(q)};
          animation-fill-mode: both;
        }

        .anim-slide {
          animation: anim-slide ${D}s ${Qe($)} ${F}s ${It(U)} ${Ot(q)};
          animation-fill-mode: both;
        }

        .anim-scale {
          animation: anim-scale ${D}s ${Qe($)} ${F}s ${It(U)} ${Ot(q)};
          animation-fill-mode: both;
        }

        .anim-rotate {
          animation: anim-rotate ${D}s ${Qe($)} ${F}s ${It(U)} ${Ot(q)};
          animation-fill-mode: both;
        }

        .anim-flip {
