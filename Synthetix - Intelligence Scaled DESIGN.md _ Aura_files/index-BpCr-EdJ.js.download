          .edit-mode-label {
            position: absolute !important;
            background: #3b82f6 !important;
            color: white !important;
            font-size: 10px !important;
            font-weight: 600 !important;
            padding: 2px 6px !important;
            border-radius: 3px !important;
            font-family: system-ui, -apple-system, sans-serif !important;
            z-index: 10000 !important;
            pointer-events: none !important;
            text-transform: uppercase !important;
            letter-spacing: 0.5px !important;
            transform: translateY(-100%) !important;
            margin-top: -4px !important;
            white-space: nowrap !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1) !important;
            display: flex !important;
            align-items: center !important;
            gap: 2px !important;
          }
          .edit-mode-label.edit-mode-label-react {
            background: linear-gradient(135deg, #0b1f3a, #14345f) !important;
            border: 1px solid rgba(97, 218, 251, 0.35) !important;
            color: #61dafb !important;
            text-transform: none !important;
            letter-spacing: 0.02em !important;
            box-shadow: 0 4px 14px rgba(11, 31, 58, 0.28) !important;
          }
          .edit-mode-label-icon {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 11px !important;
            height: 11px !important;
            flex-shrink: 0 !important;
            pointer-events: none !important;
            margin-right: 2px !important;
          }
          .edit-mode-label-icon svg {
            width: 11px !important;
            height: 11px !important;
            overflow: visible !important;
          }
          .edit-mode-label-text {
            pointer-events: none !important;
          }
          .edit-mode-move-btn {
            pointer-events: auto !important;
            background: rgba(255, 255, 255, 0.2) !important;
            border: none !important;
            color: white !important;
            width: 16px !important;
            height: 16px !important;
            border-radius: 2px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            font-size: 8px !important;
            font-weight: bold !important;
            transition: background-color 0.2s !important;
            position: relative !important;
            top: 0 !important;
            left: 4px !important;
          }
          .edit-mode-move-btn:hover {
            background: rgba(255, 255, 255, 0.3) !important;
          }
          .edit-mode-label.edit-mode-label-react .edit-mode-move-btn {
            background: rgba(97, 218, 251, 0.16) !important;
            color: #d9f7ff !important;
          }
          .edit-mode-label.edit-mode-label-react .edit-mode-move-btn:hover {
            background: rgba(97, 218, 251, 0.24) !important;
          }
          .edit-mode-move-btn:disabled {
            opacity: 0.3 !important;
            cursor: not-allowed !important;
          }
          .edit-mode-bottom-btn {
            position: absolute !important;
            color: white !important;
            font-size: 10px !important;
            font-weight: 600 !important;
            padding: 4px 8px !important;
            border-radius: 3px !important;
            font-family: system-ui, -apple-system, sans-serif !important;
            z-index: 10000 !important;
            pointer-events: auto !important;
            text-transform: uppercase !important;
            letter-spacing: 0.5px !important;
            transform: translateY(4px) !important;
            white-space: nowrap !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1) !important;
            border: none !important;
            cursor: pointer !important;
            transition: background-color 0.2s !important;
            display: inline-block !important;
          }
          .edit-mode-bottom-btn.add-new {
            background: #10b981 !important;
          }
          .edit-mode-bottom-btn.add-new:hover {
            background: #059669 !important;
          }
          .edit-mode-bottom-btn.replace {
            background: #10b981 !important;
          }
          .edit-mode-bottom-btn.replace:hover {
            background: #059669 !important;
          }
          .edit-mode-bottom-btn.image-gen {
            background: #10b981 !important;
          }
          .edit-mode-bottom-btn.image-gen:hover {
            background: #059669 !important;
          }
          .edit-mode-bottom-btn.duplicate {
            background: #10b981 !important;
          }
          .edit-mode-bottom-btn.duplicate:hover {
            background: #059669 !important;
          }
          .edit-mode-bottom-btn.menu {
            background: #10b981 !important;
          }
          .edit-mode-bottom-btn.menu:hover {
            background: #059669 !important;
          }
          .edit-mode-dragging {
            opacity: 0.7 !important;
            outline: 2px dashed #f59e42 !important;
            cursor: grabbing !important;
            z-index: 10001 !important;
            user-select: none !important;
