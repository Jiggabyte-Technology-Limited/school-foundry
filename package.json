{
  "name": "schoolfoundry",
  "version": "1.0.0",
  "description": "SchoolFoundry - School Management System",
  "main": "dist/main.js",
  "build": {
    "appId": "com.schoolfoundry.app",
    "productName": "SchoolFoundry",
    "win": {
      "icon": "public/img/schoolfoundry-icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/uninstaller.nsh"
    }
  },
  "scripts": {
    "dev": "vite & electron .",
    "build": "node scripts/clear-prod-db.js && vite build && electron-builder",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "bcryptjs": "^2.4.3",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  }
}
